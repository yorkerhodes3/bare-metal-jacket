# Copy to .env after Tailscale is connected. Never use 0.0.0.0 here.
BMJ_BIND_ADDRESS=127.0.0.1
BMJ_NODE_MANIFEST=./node.example.json
BMJ_OLLAMA_PORT=11434
BMJ_STATUS_PORT=9180

# RTX 3090 profile: load one model at a time and limit parallel inference.
OLLAMA_KEEP_ALIVE=30m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_QUEUE=16
OLLAMA_MODELS=qwen3:14b,gemma3:12b,deepseek-r1:8b
