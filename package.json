{
  "name": "bare-metal-jacket",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contract-first scaffold for a self-hosted, bare-metal developer platform.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint:markdown && npm run lint:openapi && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:markdown": "markdownlint-cli2",
    "lint:openapi": "redocly lint openapi/control-plane.yaml openapi/lab-gateway.yaml",
    "backup:foundation": "node scripts/backup-foundation.mjs",
    "preflight:deployment": "node scripts/deployment-preflight.mjs",
    "scaffold:lab-project": "node scripts/scaffold-lab-project.mjs",
    "smoke:b3iq-proxy": "node scripts/pages-proxy-smoke.mjs",
    "smoke:deployment": "node scripts/deployment-smoke.mjs",
    "smoke:gpu-worker": "node scripts/gpu-worker-smoke.mjs",
    "test": "node scripts/validate-structure.mjs && node --test tests/deployment/*.test.mjs tests/gpu-worker/*.test.mjs tests/lab-client/*.test.mjs",
    "validate:hardware-node": "node scripts/validate-hardware-node.mjs",
    "validate:lab-project": "node scripts/validate-lab-project.mjs",
    "verify:backup": "node scripts/verify-foundation-backup.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.47.0",
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6"
  }
}
